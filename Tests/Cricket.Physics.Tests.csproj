<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Cricket.Physics.csproj" />
    <Compile Include="../Presentation/**/*.cs" Link="Presentation/%(Filename)%(Extension)" />
    <None Include="../Config/batsman.json" Link="Config/batsman.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Config/field.json" Link="Config/field.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Config/audio.json" Link="Config/audio.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
